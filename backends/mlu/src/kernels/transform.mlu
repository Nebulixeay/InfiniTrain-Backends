// 纯 BANG C kernel + 启动器（cncc 编译，只允许 C++11 级别语法，不含框架头）。
// 框架集成见同目录 transform.cc。
// 语义对应上游 src/kernels/cuda/transform.cu 与 slice.cu。
// 与 CUDA 版的差异：维度/步长元数据以 POD（MluIndexMeta）按值传入 kernel
// 参数空间，不再需要 cudaMallocAsync + H2D 上传。

#include <stdint.h>

#include <bang.h>

#include "kernels/mlu_kernel_api.h"

namespace {
using infini_train::kernels::mlu::MluIndexMeta;
using infini_train::kernels::mlu::MluScalarType;

constexpr uint32_t kDefaultTaskCount = 4;

// 并行度（016 核对，沿用 015 已证实的同一机制）：本工具链下 dim.x*dim.y*dim.z 是本次启动
// 占用的 MLU core 数，taskDim = core 数 / 每个 task 占用的 core 数（cnrtFuncTypeBlock 为 1，
// cnrt.h:160-182），taskId ∈ [0, taskDim) 且各 task 唯一。因此按输出线性下标
// idx = taskId、步长 taskDim 分片，每个输出元素恰被一个 task 写一次，无需跨 task 同步。
// 依据：samples/BANG/0_Concepts_and_Techniques/global_var（cnrtFuncTypeBlock + dim={4,4,1}，
// 用 taskId 索引 16 个 __mlu_device__ 全局量并逐槽自校验 PASSED）、1_Performance/vectoradd
// 与 1_Performance/matmul 的 taskId/taskDim 切分范式。
// 历史记录（保留）：tests/math_selftest 的探针在 cnrtFuncTypeUnion1 + dim={1,1,1} 下报
// cnInvokeKernel 100006 CN_ERROR_INVALID_VALUE（1 core 少于 Union1 要求的 4 core，启动被驱动
// 拒绝），而 dim={4,1,1} 下 taskDim=1、其 “taskIdX*coreDim+coreId” 公式只覆盖 1/4 下标。
// 故旧结论“多任务/Union1 下循环写 GDRAM 只有首尾落盘”源于错误 dim 与错误索引公式，
// 不构成对多任务并行的否定；原始日志见协作沟通/001、015/Kimi.md 与 016/Kimi.md K-001。

// ----------------------------- Tril / Triu -----------------------------
// 前向反向同形：满足条件保留原值，否则置 0

template <typename T, bool kTriu>
__mlu_global__ void TrilTriuKernel(const T *input, T *output, int64_t rows, int64_t cols, int64_t diagonal) {
    const int64_t n = rows * cols;
    for (int64_t idx = taskId; idx < n; idx += taskDim) {
        const int64_t row = idx / cols;
        const int64_t col = idx % cols;
        const bool keep = kTriu ? (row - col + diagonal <= 0) : (row - col + diagonal >= 0);
        output[idx] = keep ? input[idx] : static_cast<T>(0);
    }
}

// ----------------------------- Transpose -----------------------------

template <typename T>
__mlu_global__ void TransposeKernel(const T *input, T *output, MluIndexMeta meta, int64_t dim0, int64_t dim1,
                                    int64_t num_elements) {
    for (int64_t idx = taskId; idx < num_elements; idx += taskDim) {
        int64_t remaining = idx;
        int64_t coords[MLU_MAX_META_DIMS];
        for (int i = 0; i < meta.ndim; ++i) {
            coords[i] = remaining / meta.out_strides[i];
            remaining %= meta.out_strides[i];
        }
        const int64_t tmp = coords[dim0];
        coords[dim0] = coords[dim1];
        coords[dim1] = tmp;
        int64_t in_flat = 0;
        for (int i = 0; i < meta.ndim; ++i) { in_flat += coords[i] * meta.in_strides[i]; }
        output[idx] = input[in_flat];
    }
}

// ----------------------------- Slice -----------------------------

template <typename T>
__mlu_global__ void SliceForwardKernel(const T *input, T *output, MluIndexMeta meta, int64_t num_elements) {
    for (int64_t out_idx = taskId; out_idx < num_elements; out_idx += taskDim) {
        int64_t in_index = 0;
        for (int i = 0; i < meta.ndim; ++i) {
            const int64_t idx = (out_idx / meta.out_strides[i]) % meta.dims[i];
            in_index += (meta.starts[i] + idx * meta.steps[i]) * meta.in_strides[i];
        }
        output[out_idx] = input[in_index];
    }
}

// grad_input 调用前必须已清零（Fill 在同一 queue 上先行完成，与下面的分散写不构成竞争）。
// 并行安全性（016/K-001 §5 C3）：in_index = Σ_i (starts[i] + idx_i*steps[i]) * in_strides[i]，
// 对 steps[i] >= 1，out_coord 是双射、in_strides 是输入的非退化行主序步长，故 out_idx -> in_index
// 为单射：不同 task 不会写同一个 grad_input 元素，无需 atomic，结果确定。
template <typename T>
__mlu_global__ void SliceBackwardKernel(const T *grad_output, T *grad_input, MluIndexMeta meta, int64_t num_elements) {
    for (int64_t out_idx = taskId; out_idx < num_elements; out_idx += taskDim) {
        int64_t in_index = 0;
        for (int i = 0; i < meta.ndim; ++i) {
            const int64_t idx = (out_idx / meta.out_strides[i]) % meta.dims[i];
            in_index += (meta.starts[i] + idx * meta.steps[i]) * meta.in_strides[i];
        }
        grad_input[in_index] = grad_output[out_idx];
    }
}

// ----------------------------- Mask（MaskedFill） -----------------------------
// kTail: mask[i % mask_size]；kLead: mask[i / inner]
// mask 在 host 侧已 Cast 成与 input 相同 dtype，按 == 1 判定（与 CUDA 版一致）

template <typename T, bool kLead>
__mlu_global__ void MaskForwardKernel(const T *input, const T *mask, T *output, T value, int64_t mask_extent,
                                      int64_t inner, int64_t num_elements) {
    for (int64_t i = taskId; i < num_elements; i += taskDim) {
        const int64_t mask_idx = kLead ? (i / inner) : (i % mask_extent);
        output[i] = (mask[mask_idx] == static_cast<T>(1)) ? value : input[i];
    }
}

template <typename T, bool kLead>
__mlu_global__ void MaskBackwardKernel(const T *grad_output, const T *mask, T *grad_input, int64_t mask_extent,
                                       int64_t inner, int64_t num_elements) {
    for (int64_t i = taskId; i < num_elements; i += taskDim) {
        const int64_t mask_idx = kLead ? (i / inner) : (i % mask_extent);
        grad_input[i] = (mask[mask_idx] == static_cast<T>(1)) ? static_cast<T>(0) : grad_output[i];
    }
}

// ----------------------------- 启动器 -----------------------------

// 启动配置：Block + {4,4,1} = 16 core / 16 task（厂商 global_var 示例同形，K-001 §4/§5）。
const cnrtDim3_t kDim = {4, 4, 1};

template <typename T>
void TrilTriuTyped(const void *input, void *output, int64_t rows, int64_t cols, int64_t diagonal, bool upper,
                   cnrtQueue_t queue) {
    if (upper) {
        TrilTriuKernel<T, true><<<kDim, cnrtFuncTypeBlock, queue>>>(static_cast<const T *>(input),
                                                                    static_cast<T *>(output), rows, cols, diagonal);
    } else {
        TrilTriuKernel<T, false><<<kDim, cnrtFuncTypeBlock, queue>>>(static_cast<const T *>(input),
                                                                     static_cast<T *>(output), rows, cols, diagonal);
    }
}

template <typename T>
void TransposeTyped(const void *input, void *output, MluIndexMeta meta, int64_t dim0, int64_t dim1,
                    int64_t num_elements, cnrtQueue_t queue) {
    TransposeKernel<T><<<kDim, cnrtFuncTypeBlock, queue>>>(static_cast<const T *>(input), static_cast<T *>(output),
                                                           meta, dim0, dim1, num_elements);
}

template <typename T>
void SliceForwardTyped(const void *input, void *output, MluIndexMeta meta, int64_t num_elements, cnrtQueue_t queue) {
    SliceForwardKernel<T><<<kDim, cnrtFuncTypeBlock, queue>>>(static_cast<const T *>(input), static_cast<T *>(output),
                                                              meta, num_elements);
}

template <typename T>
void SliceBackwardTyped(const void *grad_output, void *grad_input, MluIndexMeta meta, int64_t num_elements,
                        cnrtQueue_t queue) {
    SliceBackwardKernel<T><<<kDim, cnrtFuncTypeBlock, queue>>>(static_cast<const T *>(grad_output),
                                                               static_cast<T *>(grad_input), meta, num_elements);
}

template <typename T>
void MaskForwardTyped(const void *input, const void *mask, void *output, float value, bool lead, int64_t mask_extent,
                      int64_t inner, int64_t num_elements, cnrtQueue_t queue) {
    const T v = static_cast<T>(value);
    if (lead) {
        MaskForwardKernel<T, true>
            <<<kDim, cnrtFuncTypeBlock, queue>>>(static_cast<const T *>(input), static_cast<const T *>(mask),
                                                 static_cast<T *>(output), v, mask_extent, inner, num_elements);
    } else {
        MaskForwardKernel<T, false>
            <<<kDim, cnrtFuncTypeBlock, queue>>>(static_cast<const T *>(input), static_cast<const T *>(mask),
                                                 static_cast<T *>(output), v, mask_extent, inner, num_elements);
    }
}

template <typename T>
void MaskBackwardTyped(const void *grad_output, const void *mask, void *grad_input, bool lead, int64_t mask_extent,
                       int64_t inner, int64_t num_elements, cnrtQueue_t queue) {
    if (lead) {
        MaskBackwardKernel<T, true>
            <<<kDim, cnrtFuncTypeBlock, queue>>>(static_cast<const T *>(grad_output), static_cast<const T *>(mask),
                                                 static_cast<T *>(grad_input), mask_extent, inner, num_elements);
    } else {
        MaskBackwardKernel<T, false>
            <<<kDim, cnrtFuncTypeBlock, queue>>>(static_cast<const T *>(grad_output), static_cast<const T *>(mask),
                                                 static_cast<T *>(grad_input), mask_extent, inner, num_elements);
    }
}

#define MLU_TF_NUMERIC_SWITCH(fn, ...)                                                                                 \
    switch (type) {                                                                                                    \
    case MluScalarType::kU8:                                                                                           \
        fn<uint8_t>(__VA_ARGS__);                                                                                      \
        return;                                                                                                        \
    case MluScalarType::kI8:                                                                                           \
        fn<int8_t>(__VA_ARGS__);                                                                                       \
        return;                                                                                                        \
    case MluScalarType::kU16:                                                                                          \
        fn<uint16_t>(__VA_ARGS__);                                                                                     \
        return;                                                                                                        \
    case MluScalarType::kI16:                                                                                          \
        fn<int16_t>(__VA_ARGS__);                                                                                      \
        return;                                                                                                        \
    case MluScalarType::kU32:                                                                                          \
        fn<uint32_t>(__VA_ARGS__);                                                                                     \
        return;                                                                                                        \
    case MluScalarType::kI32:                                                                                          \
        fn<int32_t>(__VA_ARGS__);                                                                                      \
        return;                                                                                                        \
    case MluScalarType::kU64:                                                                                          \
        fn<uint64_t>(__VA_ARGS__);                                                                                     \
        return;                                                                                                        \
    case MluScalarType::kI64:                                                                                          \
        fn<int64_t>(__VA_ARGS__);                                                                                      \
        return;                                                                                                        \
    case MluScalarType::kF16:                                                                                          \
        fn<half>(__VA_ARGS__);                                                                                         \
        return;                                                                                                        \
    case MluScalarType::kBF16:                                                                                         \
        fn<bfloat16_t>(__VA_ARGS__);                                                                                   \
        return;                                                                                                        \
    case MluScalarType::kF32:                                                                                          \
        fn<float>(__VA_ARGS__);                                                                                        \
        return;                                                                                                        \
    default:                                                                                                           \
        return;                                                                                                        \
    }
} // namespace

namespace infini_train::kernels::mlu {

void TrilTriuLaunch(const void *input, void *output, int64_t rows, int64_t cols, int64_t diagonal, bool upper,
                    MluScalarType type, cnrtQueue_t queue) {
    MLU_TF_NUMERIC_SWITCH(TrilTriuTyped, input, output, rows, cols, diagonal, upper, queue)
}

void TransposeLaunch(const void *input, void *output, MluIndexMeta meta, int64_t dim0, int64_t dim1,
                     int64_t num_elements, MluScalarType type, cnrtQueue_t queue) {
    MLU_TF_NUMERIC_SWITCH(TransposeTyped, input, output, meta, dim0, dim1, num_elements, queue)
}

void SliceForwardLaunch(const void *input, void *output, MluIndexMeta meta, int64_t num_elements, MluScalarType type,
                        cnrtQueue_t queue) {
    MLU_TF_NUMERIC_SWITCH(SliceForwardTyped, input, output, meta, num_elements, queue)
}

void SliceBackwardLaunch(const void *grad_output, void *grad_input, MluIndexMeta meta, int64_t num_elements,
                         MluScalarType type, cnrtQueue_t queue) {
    MLU_TF_NUMERIC_SWITCH(SliceBackwardTyped, grad_output, grad_input, meta, num_elements, queue)
}

void MaskForwardLaunch(const void *input, const void *mask, void *output, float value, bool lead, int64_t mask_extent,
                       int64_t inner, int64_t num_elements, MluScalarType type, cnrtQueue_t queue) {
    MLU_TF_NUMERIC_SWITCH(MaskForwardTyped, input, mask, output, value, lead, mask_extent, inner, num_elements, queue)
}

void MaskBackwardLaunch(const void *grad_output, const void *mask, void *grad_input, bool lead, int64_t mask_extent,
                        int64_t inner, int64_t num_elements, MluScalarType type, cnrtQueue_t queue) {
    MLU_TF_NUMERIC_SWITCH(MaskBackwardTyped, grad_output, mask, grad_input, lead, mask_extent, inner, num_elements,
                          queue)
}

} // namespace infini_train::kernels::mlu
