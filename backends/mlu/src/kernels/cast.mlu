// 纯 BANG C kernel + 启动器（cncc 编译，只允许 C++11 级别语法，不含框架头）。
// 框架集成见同目录 cast.cc。
// NOTE(MLU-VERIFY): BANG C 中 half/bfloat16_t 与整型互转的 static_cast 行为
// （截断/舍入语义）需与 baseline 对齐时复核。

#include <stdint.h>
#include <type_traits>

#include <bang.h>

#include "kernels/mlu_kernel_api.h"

namespace {
constexpr uint32_t kDefaultTaskCount = 4;

// 031：并行度（沿用 015/016/017 已证实、019/020/024 复核的同一机制）：本工具链下
// dim.x*dim.y*dim.z 是本次启动占用的 MLU core 数，taskDim = core 数 / 每个 task 占用的 core 数
// （cnrtFuncTypeBlock 为 1），taskId ∈ [0, taskDim) 且各 task 唯一。CastKernel 是纯逐元素转换，
// 既无跨元素归约也无跨元素写，因此按 idx = taskId、步长 taskDim 分片可保证每个元素恰被一个 task
// 读写一次，结果与单任务版逐位相同（16 位浮点仍经 float 中转，表达式不变）。
// 依据：samples/BANG/0_Concepts_and_Techniques/global_var（cnrtFuncTypeBlock + dim={4,4,1}，
// 用 taskId 索引 16 个 __mlu_device__ 全局量并逐槽自校验）。更大 Block 维度无厂商示例/文档支持，
// 记 PARALLEL_UNPROVEN，本次不使用。
const cnrtDim3_t kDim = {4, 4, 1};

template <typename Tdst, typename Tsrc> __mlu_global__ void CastKernel(Tdst *dst, const Tsrc *src, int64_t size) {

    for (int64_t idx = taskId; idx < size; idx += taskDim) {
        constexpr bool src_reduced = std::is_same_v<Tsrc, half> || std::is_same_v<Tsrc, bfloat16_t>;
        constexpr bool dst_reduced = std::is_same_v<Tdst, half> || std::is_same_v<Tdst, bfloat16_t>;
        if constexpr (src_reduced || dst_reduced) {
            // 任一侧是 16 位浮点都经 float 中转：BANG C 下 bf16 直接 static_cast
            // 到整型/double 有歧义，且与框架 Cast"经 float 两步走"语义一致
            dst[idx] = static_cast<Tdst>(static_cast<float>(src[idx]));
        } else {
            dst[idx] = static_cast<Tdst>(src[idx]);
        }
    }
}

template <typename Tdst, typename Tsrc>
void CastTyped(void *dst, const void *src, int64_t num_elements, cnrtQueue_t queue) {
    CastKernel<Tdst, Tsrc>
        <<<kDim, cnrtFuncTypeBlock, queue>>>(static_cast<Tdst *>(dst), static_cast<const Tsrc *>(src), num_elements);
}

#define MLU_CAST_SRC_SWITCH(Tdst)                                                                                      \
    switch (src_type) {                                                                                                \
    case MluScalarType::kBool:                                                                                         \
        CastTyped<Tdst, bool>(dst, src, num_elements, queue);                                                          \
        return;                                                                                                        \
    case MluScalarType::kU8:                                                                                           \
        CastTyped<Tdst, uint8_t>(dst, src, num_elements, queue);                                                       \
        return;                                                                                                        \
    case MluScalarType::kI8:                                                                                           \
        CastTyped<Tdst, int8_t>(dst, src, num_elements, queue);                                                        \
        return;                                                                                                        \
    case MluScalarType::kU16:                                                                                          \
        CastTyped<Tdst, uint16_t>(dst, src, num_elements, queue);                                                      \
        return;                                                                                                        \
    case MluScalarType::kI16:                                                                                          \
        CastTyped<Tdst, int16_t>(dst, src, num_elements, queue);                                                       \
        return;                                                                                                        \
    case MluScalarType::kU32:                                                                                          \
        CastTyped<Tdst, uint32_t>(dst, src, num_elements, queue);                                                      \
        return;                                                                                                        \
    case MluScalarType::kI32:                                                                                          \
        CastTyped<Tdst, int32_t>(dst, src, num_elements, queue);                                                       \
        return;                                                                                                        \
    case MluScalarType::kU64:                                                                                          \
        CastTyped<Tdst, uint64_t>(dst, src, num_elements, queue);                                                      \
        return;                                                                                                        \
    case MluScalarType::kI64:                                                                                          \
        CastTyped<Tdst, int64_t>(dst, src, num_elements, queue);                                                       \
        return;                                                                                                        \
    case MluScalarType::kF16:                                                                                          \
        CastTyped<Tdst, half>(dst, src, num_elements, queue);                                                          \
        return;                                                                                                        \
    case MluScalarType::kBF16:                                                                                         \
        CastTyped<Tdst, bfloat16_t>(dst, src, num_elements, queue);                                                    \
        return;                                                                                                        \
    case MluScalarType::kF32:                                                                                          \
        CastTyped<Tdst, float>(dst, src, num_elements, queue);                                                         \
        return;                                                                                                        \
    default:                                                                                                           \
        /* MLU 设备不支持 FP64（kF64 不落到这里；host 侧 dispatch 已排除）*/                          \
        return;                                                                                                        \
    }
} // namespace

namespace infini_train::kernels::mlu {

void CastLaunch(void *dst, const void *src, MluScalarType dst_type, MluScalarType src_type, int64_t num_elements,
                cnrtQueue_t queue) {
    switch (dst_type) {
    case MluScalarType::kBool:
        MLU_CAST_SRC_SWITCH(bool)
        return;
    case MluScalarType::kU8:
        MLU_CAST_SRC_SWITCH(uint8_t)
        return;
    case MluScalarType::kI8:
        MLU_CAST_SRC_SWITCH(int8_t)
        return;
    case MluScalarType::kU16:
        MLU_CAST_SRC_SWITCH(uint16_t)
        return;
    case MluScalarType::kI16:
        MLU_CAST_SRC_SWITCH(int16_t)
        return;
    case MluScalarType::kU32:
        MLU_CAST_SRC_SWITCH(uint32_t)
        return;
    case MluScalarType::kI32:
        MLU_CAST_SRC_SWITCH(int32_t)
        return;
    case MluScalarType::kU64:
        MLU_CAST_SRC_SWITCH(uint64_t)
        return;
    case MluScalarType::kI64:
        MLU_CAST_SRC_SWITCH(int64_t)
        return;
    case MluScalarType::kF16:
        MLU_CAST_SRC_SWITCH(half)
        return;
    case MluScalarType::kBF16:
        MLU_CAST_SRC_SWITCH(bfloat16_t)
        return;
    case MluScalarType::kF32:
        MLU_CAST_SRC_SWITCH(float)
        return;
    default:
        // MLU 设备不支持 FP64（kF64 已由 host 侧 dispatch 排除）
        return;
    }
}

} // namespace infini_train::kernels::mlu
